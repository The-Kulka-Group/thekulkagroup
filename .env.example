# Kulka's Supabase, as a Postgres connection string. The app reads the database
# in SQL rather than through a REST client, so this is a connection string and
# not a project URL plus key. Vercel's Supabase integration sets POSTGRES_URL;
# DATABASE_URL is the local equivalent.
#
# Supabase dashboard: Project settings, Database, Connection string, URI.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# An approved project already stored in Kulka's database. There is no example
# fallback because production starts empty and invented cost values are banned.
ROM_PROJECT_ID=

# Supabase Auth browser settings. The publishable key is safe to expose to the
# browser. Do not put the service-role key in this app, with one exception:
# SUPABASE_SERVICE_ROLE_KEY below, server-only, for the published-budget PDF bucket.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only access list. Production accepts exactly five unique addresses.
KULKA_AUTH_ALLOWED_EMAILS=user1@example.com,user2@example.com,user3@example.com,user4@example.com,user5@example.com

# Server-only key for approved Vision collection jobs. Keep this unset unless
# an operator activates the separate scheduler configuration.
VISION_DISCOVERY_CRON_SECRET=

# Server-owned canonical origin for password emails.
KULKA_SITE_URL=https://kulka.ai

# Server-only. Publishing a budget stores its PDF in the private Supabase
# Storage bucket "published-budget-pdfs" (created on first use), and
# /b/<token>.pdf reads it back. Storage has no SQL door, so this is the one
# place the app holds the service-role key. Without it a publish still works
# and the version simply has no PDF.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, local only. Path to a Chromium or Chrome binary for the PDF print
# when Playwright's own Chromium is missing. On Vercel the print uses
# @sparticuz/chromium and this is ignored.
KULKA_CHROMIUM_PATH=

# Optional, server-only. When a reader opens a client comment thread that needs
# Kulka, the app posts one JSON body, {text, sentence, link}, to this address:
# the one sentence Home shows and a link to the thread. It never sends the
# message body or the reader's email, and never sends anything to the client.
# Point it at a channel Kulka owns, not a BLDG Labs one. The address is a
# secret. Leave it unset and nothing is sent, which is the default.
KULKA_COMMENT_WEBHOOK_URL=

# LA-2279: Fireflies meetings. The API key is from Fireflies, Settings,
# Developer settings, on the meetings@thekulkagroup.com account. The webhook
# secret is the Signing Secret set on the Fireflies Webhooks V2 page, pointed
# at /api/meetings/fireflies for meeting.transcribed and meeting.summarized.
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
# Vercel sends this to the refresh schedule (vercel.json) as a Bearer token.
CRON_SECRET=

# LA-2283: Autodesk Construction Cloud project list. Create an app at
# aps.autodesk.com (client id and secret), then Kulka's ACC account admin adds
# that client id under Account Admin, Custom Integrations. ACC_ACCOUNT_ID is the
# account (hub) id; a "b." prefix from the Data Management API is fine.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
ACC_ACCOUNT_ID=

# LA-2894: Connect Autodesk on the Projects page signs one Kulka person in to
# Autodesk, so Kulka can read Issues, RFIs, Submittals and Cost as them. This is
# the "Kulka AI User Sign-in" app (Traditional Web App), separate from the
# Server-to-Server app above. Its callback URLs are
# https://kulka-ai-the-kulka-group.vercel.app/api/autodesk/callback and
# http://localhost:3000/api/autodesk/callback, and the ACC account admin adds
# its client id under Account Admin, Custom Integrations too.
# AUTODESK_TOKEN_KEY seals the saved tokens: 32 random bytes, base64
# (openssl rand -base64 32). Changing it means connecting again.
APS_USER_CLIENT_ID=
APS_USER_CLIENT_SECRET=
AUTODESK_TOKEN_KEY=
