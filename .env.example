# Kulka's Supabase, as a Postgres connection string. The app reads the database
# in SQL rather than through a REST client, so this is a connection string and
# not a project URL plus key. Vercel's Supabase integration sets POSTGRES_URL;
# DATABASE_URL is the local equivalent.
#
# Supabase dashboard: Project settings, Database, Connection string, URI.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# An approved project already stored in Kulka's database. There is no example
# fallback because production starts empty and invented cost values are banned.
ROM_PROJECT_ID=

# Supabase Auth browser settings. The publishable key is safe to expose to the
# browser. Do not put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only access list. Production accepts exactly five unique addresses.
KULKA_AUTH_ALLOWED_EMAILS=user1@example.com,user2@example.com,user3@example.com,user4@example.com,user5@example.com

# Temporary LA-173 workspace access. Keep this absent or set to 0 by default.
# Setting it to exactly 1 bypasses page and API authentication. Remove it from
# Vercel and redeploy to restore the login gate.
KULKA_AUTH_BYPASS=0

# Server-only key for approved Vision collection jobs. Keep this unset unless
# an operator activates the separate scheduler configuration.
VISION_DISCOVERY_CRON_SECRET=
