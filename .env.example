# Kulka's Supabase, as a direct Postgres connection string. The app reads the
# database in SQL rather than through a REST client, so this is a connection
# string and not a project URL plus key.
#
# Supabase dashboard: Project settings, Database, Connection string, URI.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
