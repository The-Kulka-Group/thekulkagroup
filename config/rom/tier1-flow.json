{
  "skill": "rom_tier1",
  "version": 1,
  "title": "Tier-1 conceptual budget",
  "note": "Question text here is placeholder until the working session supplies the real fields (LA-20). This file declares what is asked, in what order, and which engine input each answer feeds. It never declares what an answer costs: no rates, no multipliers, no dollar figures. Every surface, the site and the Claude wrapper alike, reads this one file.",
  "questions": [
    {
      "id": "project_type",
      "prompt": "What kind of project is this?",
      "kind": "choice",
      "required": true,
      "choices": [
        { "value": "multifamily", "label": "Multifamily" },
        { "value": "self_storage", "label": "Self Storage" }
      ],
      "mapsTo": { "target": "engine_input", "name": "projectType" }
    },
    {
      "id": "construction_kind",
      "prompt": "Is this new construction or a renovation?",
      "kind": "choice",
      "required": true,
      "choices": [
        { "value": "new", "label": "New Construction" },
        { "value": "renovation", "label": "Renovation" }
      ],
      "mapsTo": { "target": "engine_input", "name": "constructionKind" }
    },
    {
      "id": "gross_square_feet",
      "prompt": "How many gross square feet is the building?",
      "help": "Gross building area. Not footprint, net area, or rentable area.",
      "kind": "number",
      "required": true,
      "mapsTo": { "target": "engine_input", "name": "grossSquareFeet" }
    },
    {
      "id": "stories_above_grade",
      "prompt": "Stories Above Grade",
      "kind": "number",
      "required": false,
      "requiredWhen": { "questionId": "project_type", "equals": ["multifamily"] },
      "mapsTo": { "target": "intake_field", "name": "storiesAboveGrade" }
    },
    {
      "id": "unit_count",
      "prompt": "Unit Count",
      "kind": "number",
      "required": false,
      "requiredWhen": { "questionId": "project_type", "equals": ["multifamily"] },
      "mapsTo": { "target": "intake_field", "name": "unitCount" }
    },
    {
      "id": "building_count",
      "prompt": "Building Count",
      "help": "Defaults to 1.",
      "kind": "number",
      "required": false,
      "mapsTo": { "target": "intake_field", "name": "buildingCount" }
    },
    {
      "id": "zip",
      "prompt": "ZIP",
      "help": "Five digits.",
      "kind": "text",
      "required": false,
      "pattern": "^[0-9]{5}$",
      "mapsTo": { "target": "intake_field", "name": "zip" }
    },
    {
      "id": "labor_type",
      "prompt": "Labor Type",
      "kind": "choice",
      "required": false,
      "choices": [
        { "value": "open_shop", "label": "Open Shop" },
        { "value": "union", "label": "Union" },
        { "value": "prevailing_wage", "label": "Prevailing Wage" }
      ],
      "mapsTo": { "target": "intake_field", "name": "laborType" }
    },
    {
      "id": "parking_type",
      "prompt": "What kind of parking does the project have?",
      "help": "Required on every project. Parking is never assumed.",
      "kind": "choice",
      "required": true,
      "choices": [
        { "value": "none", "label": "None" },
        { "value": "surface", "label": "Surface" },
        { "value": "structured", "label": "Structured" },
        { "value": "underground", "label": "Underground" },
        { "value": "dont_know", "label": "Don't Know" }
      ],
      "mapsTo": { "target": "intake_field", "name": "parkingType" }
    },
    {
      "id": "demolition",
      "prompt": "Is there anything on the site to demolish?",
      "kind": "branch_gate",
      "required": true,
      "opens": ["demolition_structure_count"],
      "mapsTo": { "target": "branch_gate", "section": "demolition" }
    },
    {
      "id": "demolition_structure_count",
      "prompt": "How many structures come down?",
      "kind": "number",
      "required": true,
      "opens": ["demolition_structure_square_feet", "demolition_structure_type"],
      "opensWhen": { "type": "number_at_least_one" },
      "mapsTo": { "target": "intake_field", "name": "demolitionStructureCount" }
    },
    {
      "id": "demolition_structure_square_feet",
      "prompt": "How many square feet of structure come down?",
      "help": "Gross floor area, every floor counted.",
      "kind": "number",
      "required": true,
      "mapsTo": { "target": "intake_field", "name": "demolitionStructureSquareFeet" }
    },
    {
      "id": "demolition_structure_type",
      "prompt": "What kind of structure comes down?",
      "kind": "choice",
      "required": true,
      "choices": [
        { "value": "wood_frame_type_v", "label": "Wood Frame (Type V)" },
        { "value": "masonry_bearing_wall_type_iii", "label": "Masonry Bearing Wall with Wood Floors (Type III)" },
        { "value": "pre_engineered_metal_or_light_steel", "label": "Pre-Engineered Metal or Light Steel" },
        { "value": "steel_frame_concrete_metal_deck_type_ii", "label": "Steel Frame with Concrete on Metal Deck (Type II)" },
        { "value": "cast_in_place_concrete_frame_type_i", "label": "Cast-in-Place Concrete Frame (Type I)" },
        { "value": "dont_know", "label": "Don't Know" }
      ],
      "mapsTo": { "target": "intake_field", "name": "demolitionStructureType" }
    },
    {
      "id": "levels_below_grade",
      "prompt": "Does the new building go below grade?",
      "help": "The building being built, such as a basement or underground garage.",
      "kind": "branch_gate",
      "required": true,
      "mapsTo": { "target": "branch_gate", "section": "levels_below_grade" }
    },
    {
      "id": "existing_building_tie_in",
      "prompt": "Does the work tie in to an existing building?",
      "kind": "branch_gate",
      "required": true,
      "mapsTo": { "target": "branch_gate", "section": "existing_building_tie_in" }
    },
    {
      "id": "site_conditions",
      "prompt": "Are there known groundwater or poor soil conditions?",
      "kind": "branch_gate",
      "required": true,
      "level": 2,
      "mapsTo": { "target": "branch_gate", "section": "site_conditions" }
    },
    {
      "id": "amenity_scope",
      "prompt": "Does the project include amenity scope such as a pool or an activity room?",
      "kind": "branch_gate",
      "required": true,
      "mapsTo": { "target": "branch_gate", "section": "amenity_scope" }
    },
    {
      "id": "elevator",
      "prompt": "Does the new building have an elevator?",
      "kind": "branch_gate",
      "required": true,
      "opens": ["elevator_count"],
      "mapsTo": { "target": "branch_gate", "section": "elevator" }
    },
    {
      "id": "elevator_count",
      "prompt": "Elevator Count",
      "kind": "number",
      "required": true,
      "mapsTo": { "target": "intake_field", "name": "elevatorCount" }
    },
    {
      "id": "retail_storefronts",
      "prompt": "Is there ground-floor retail with storefronts?",
      "kind": "branch_gate",
      "required": true,
      "mapsTo": { "target": "branch_gate", "section": "retail_storefronts" }
    },
    {
      "id": "balconies",
      "prompt": "Do the units have balconies?",
      "kind": "branch_gate",
      "required": true,
      "level": 3,
      "mapsTo": { "target": "branch_gate", "section": "balconies" }
    },
    {
      "id": "radio_amplifier",
      "prompt": "Does the new building need an emergency radio amplifier (BDA)?",
      "kind": "branch_gate",
      "required": true,
      "mapsTo": { "target": "branch_gate", "section": "radio_amplifier" }
    }
  ],
  "output": {
    "kind": "rom",
    "recordTbdCount": true
  }
}
